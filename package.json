{
  "name": "shubh-caterers-static",
  "version": "1.0.0",
  "private": true,
  "description": "Shubh Caterers — pure veg catering website (static pages + one Netlify Function, deployed on Netlify)",
  "type": "module",
  "scripts": {
    "images": "python generator/images.py",
    "generate": "python generator/generate.py",
    "build": "node scripts/build.mjs",
    "dev": "npm run build && netlify dev --offline",
    "serve": "netlify serve --offline",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "audit:seo": "node scripts/audit-seo.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run audit:seo && npm run test:e2e",
    "deploy:preview": "npm run build && netlify deploy --dir=dist",
    "deploy": "npm run build && netlify deploy --dir=dist --prod"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "netlify-cli": "^27.10.2",
    "node-html-parser": "^9.0.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.3",
    "esbuild": "^0.28.2",
    "nodemailer": "^7.0.13"
  }
}
