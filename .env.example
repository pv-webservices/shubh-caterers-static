# Enquiry form email settings (Netlify Function netlify/functions/enquiry.mjs).
# Never put real values in this file or in git. Set them in Netlify:
#   Site configuration > Environment variables  (scope: Functions; SMTP_PASS: Production only, "Contains secret values")
# For local testing you may copy this to .env (git-ignored) — `netlify dev` reads it.

# Zoho Mail, India data centre (shubhcaterers.in is a Zoho .in account). SSL on port 465.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
# The Zoho mailbox that sends the email (must be the mailbox you log in with)
SMTP_USER=info@shubhcaterers.in
# Zoho "Application-Specific Password" for SMTP (not the normal login password) — SECRET
SMTP_PASS=
# Where enquiries are delivered
MAIL_TO=info@shubhcaterers.in
# Sender address; must be SMTP_USER or a verified Zoho alias of it
MAIL_FROM=info@shubhcaterers.in

# Optional: extra comma-separated origins allowed to post the form (live, www, previews and localhost are built in)
ALLOWED_ORIGINS=
